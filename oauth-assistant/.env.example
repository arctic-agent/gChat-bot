# ==============================================================================
# User-Delegated OAuth Assistant Configuration
# ==============================================================================

# Default Google Chat Space ID to monitor (e.g. spaces/XXXXXXXXXXX)
GC_SPACE_NAME=spaces/YOUR_SPACE_ID

# Token & Client Credentials file paths
CREDENTIALS_FILE=credentials.json
TOKEN_FILE=token.json

# Assistant Persona & Identity
BOT_NAME=Team Assistant
USER_ALIASES=assistant,agent,bot
# (Optional) Specific Google Chat User ID to match @mentions (e.g. users/123456789)
BOT_USER_ID=
TRIGGER_MODE=smart

# If false, posts as a brand-new top-level message. If true, replies in thread.
REPLY_IN_THREAD=false

# LLM Inference Configuration (OpenAI-compatible endpoint, Fireworks, etc.)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.fireworks.ai/inference/v1
LLM_MODEL=accounts/fireworks/models/minimax-m3

# Google Drive Integration
# Folder ID or complete folder URL where the bot creates and uploads files/docs
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# Progressive Status Acknowledgment (sent if processing takes >2s)
WAITING_MESSAGE=⏳ Please wait, let me check and prepare this for you...

# Concurrency & Performance
POLL_INTERVAL_SECONDS=2.0
MESSAGE_HISTORY_PAGE_SIZE=25


