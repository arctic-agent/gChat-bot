# ==============================================================================
# Webhook Assistant Configuration
# ==============================================================================

# Target Google Chat Space ID (e.g., spaces/XXXXXXXXXXX)
GC_SPACE_NAME=spaces/YOUR_SPACE_ID

# Google Chat Incoming Webhook URL
# Generated via: Space Name -> Apps & integrations -> Manage webhooks -> Add webhook
CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/YOUR_SPACE_ID/messages?key=YOUR_KEY&token=YOUR_TOKEN

# Assistant Persona & Identity
BOT_NAME=Team Assistant
USER_ALIASES=assistant,agent,bot
# (Optional) Specific Google Chat User ID to match @mentions (e.g. users/123456789)
BOT_USER_ID=
TRIGGER_MODE=smart

# If false, posts as a brand-new top-level message. If true, replies in the same thread.
REPLY_IN_THREAD=false

# LLM Inference Configuration (OpenAI-compatible endpoint, Fireworks, etc.)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.fireworks.ai/inference/v1
LLM_MODEL=accounts/fireworks/models/minimax-m3

# (Optional) Event Monitoring via Workspace Events API & GCP Pub/Sub
GCP_PROJECT_ID=your-gcp-project-id
PUBSUB_SUBSCRIPTION_ID=your-pubsub-subscription-id
GOOGLE_APPLICATION_CREDENTIALS=service-account.json
TOKEN_FILE=token.json

# Google Drive Integration
# Folder ID or complete folder URL where the bot creates and uploads files/docs
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# Concurrency & Performance
POLL_INTERVAL_SECONDS=2.0
MAX_WORKERS=20
MESSAGE_HISTORY_PAGE_SIZE=25
